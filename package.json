{
  "name": "dsh-editor",
  "version": "10.1.0",
  "description": "Editor view for DeepSeek Harness conversations: a 3/4 editor beside the original 1/4 chat.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/terminal.js",
    "lib/index.js",
    "lib/client.js",
    "lib/link-parser.mjs",
    "src/client",
    "scripts/build-client.mjs",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-terminal-controller"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "postbuild:client": "npm test",
    "check:client-build": "node scripts/build-client.mjs --check",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "fixture:editor": "bash scripts/prepare-editor-fixture.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.52.2"
  }
}
